{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...all]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPall": "nxtPall"
      },
      "namedRegex": "^/api/auth/(?<nxtPall>.+?)(?:/)?$"
    },
    {
      "page": "/book-appointment/[id]",
      "regex": "^/book\\-appointment/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/book\\-appointment/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/invites/[id]",
      "regex": "^/invites/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/invites/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/profil/[id]",
      "regex": "^/profil/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/profil/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/request-salon-management/[id]",
      "regex": "^/request\\-salon\\-management/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/request\\-salon\\-management/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/salon/[id]/appointments",
      "regex": "^/salon/([^/]+?)/appointments(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/salon/(?<nxtPid>[^/]+?)/appointments(?:/)?$"
    },
    {
      "page": "/salon/[id]/dashboard",
      "regex": "^/salon/([^/]+?)/dashboard(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/salon/(?<nxtPid>[^/]+?)/dashboard(?:/)?$"
    },
    {
      "page": "/salon/[id]/services",
      "regex": "^/salon/([^/]+?)/services(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/salon/(?<nxtPid>[^/]+?)/services(?:/)?$"
    },
    {
      "page": "/salon/[id]/staff-management",
      "regex": "^/salon/([^/]+?)/staff\\-management(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/salon/(?<nxtPid>[^/]+?)/staff\\-management(?:/)?$"
    },
    {
      "page": "/worker/[id]",
      "regex": "^/worker/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/worker/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin-panel",
      "regex": "^/admin\\-panel(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin\\-panel(?:/)?$"
    },
    {
      "page": "/authentication",
      "regex": "^/authentication(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/authentication(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/make-appointment",
      "regex": "^/make\\-appointment(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/make\\-appointment(?:/)?$"
    },
    {
      "page": "/request-salon",
      "regex": "^/request\\-salon(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/request\\-salon(?:/)?$"
    },
    {
      "page": "/salons",
      "regex": "^/salons(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/salons(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}